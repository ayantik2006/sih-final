# APIx API Layer Configuration
APP_NAME="APIx - Real-Time Airfare Price Index API (MoSPI/RBI)"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# API Keys mapping: JSON string mapping API key -> User Role
# Roles supported: NSO_STATISTICIAN, RBI_ANALYST
API_KEYS='{"mospi-nso-key-2026":"NSO_STATISTICIAN","rbi-mpd-key-2026":"RBI_ANALYST"}'

# Database Configuration (PostgreSQL + TimescaleDB in prod, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./apix.db

# Redis Configuration for Rate Limiting (falls back to memory if unreachable)
REDIS_URL=redis://localhost:6379/0

# Rate limits (requests per minute)
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_AUTH=600

# Statistical baseline
BASE_PERIOD="2025-01-01=100"

# CORS origins (for Next.js frontend)
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
